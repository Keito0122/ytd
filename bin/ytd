#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ytd 実行エントリーポイント。
このファイルへの実行権限を付与し、PATHの通ったディレクトリに
シンボリックリンクすることで `ytd "URL"` として利用できる。
"""
import os
import sys

# このスクリプトから見て ../ が ytd パッケージのルート
_THIS_DIR = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
_PKG_ROOT = os.path.dirname(_THIS_DIR)
if _PKG_ROOT not in sys.path:
    sys.path.insert(0, _PKG_ROOT)

from com.keitodev.ytd.main import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
